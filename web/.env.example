# mock = in-browser sample data (no backend needed). live = real FastAPI + Cognito.
VITE_API_MODE=mock
# Absolute URL of the FastAPI backend (live mode only); client.ts falls back to this if unset.
VITE_API_URL=http://localhost:8000
# Highest build phase whose pages are switched on (1..7). Pages from later phases stay hidden.
VITE_RELEASE_PHASE=5
# Cognito (live mode only)
VITE_COGNITO_DOMAIN=https://relay-crm.auth.ap-south-1.amazoncognito.com
VITE_COGNITO_CLIENT_ID=
VITE_COGNITO_REDIRECT_URI=http://localhost:5173/auth/callback
