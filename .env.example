# Every setting the app reads, with safe local values.
ENV=local
ORG_ID=00000000-0000-0000-0000-000000000001
TIMEZONE_DISPLAY=Asia/Kolkata

# Database (superuser/owner for migrations, restricted role for the running app)
DATABASE_URL=postgresql+asyncpg://relay_app:relay_app@postgres:5432/relay
MIGRATION_DATABASE_URL=postgresql+asyncpg://relay:relay@postgres:5432/relay

# Auth: dev | cognito
AUTH_PROVIDER=dev
DEV_JWT_SECRET=local-dev-secret-change-me-32-bytes-min
COGNITO_REGION=ap-south-1
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=
ALLOWED_GOOGLE_DOMAIN=

# Files (MinIO locally, S3 on AWS: leave S3_ENDPOINT_URL empty there)
S3_ENDPOINT_URL=http://minio:9000
S3_PUBLIC_ENDPOINT_URL=http://localhost:9000
S3_BUCKET=relay-files
S3_ACCESS_KEY=minio
S3_SECRET_KEY=minio12345
S3_REGION=ap-south-1

# Email (Mailpit locally, SES on AWS: leave SMTP_HOST empty there)
EMAIL_BACKEND=smtp
SMTP_HOST=mailpit
SMTP_PORT=1025
EMAIL_FROM=relay@localhost

CORS_ORIGINS=http://localhost:5173
